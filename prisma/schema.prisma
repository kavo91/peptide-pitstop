// Peptide Tracker — data model (Phase 0).
// SQLite for single-user MVP; swap `provider`/datasource for Postgres later.
// SQLite has no native enums → enum-like fields are String with documented values.
// Fields tagged "ENCRYPTED" are wrapped by lib/crypto/fieldEncryption at the app
// layer (stored as ciphertext strings); keep them out of WHERE clauses.

generator client {
  provider = "prisma-client-js"
  // native = local dev (darwin); linux-musl-openssl-3.0.x = the Alpine container
  // (node:22-alpine ships OpenSSL 3.x → libssl.so.3, NOT the 1.1 the plain
  // linux-musl engine links against — otherwise every query 500s in prod).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  totpSecret   String? // ENCRYPTED
  role         String   @default("owner") // owner | member  (local accounts only)
  createdAt    DateTime @default(now())
  reorderLeadTimeDays Int? @default(14) // global fallback lead time
  reorderBufferDays   Int? @default(3)  // safety margin added to lead time
  tokenVersion Int  @default(0) // bump to revoke all existing sessions (auth hardening)
  lastTotpStep Int? // last accepted TOTP time-step — rejects replay within the window
  hydrationTargetMl Int?    // daily water-intake goal (mL); null = no target
  // Preferred syringe/pen, preselected wherever one isn't pinned on the
  // protocol (protocol default wins). Soft pointer, cleared on device delete.
  defaultSyringeId  String?
  symptomList       String? // JSON array of custom side-effect symptoms; null = curated default
  // Reminder anchors ("HH:MM" local, container TZ). Untimed daily doses remind
  // at untimedReminderTime; the still-pending nag fires at nagTime when enabled.
  untimedReminderTime String  @default("08:00")
  nagTime             String  @default("18:00")
  nagEnabled          Boolean @default(true)

  peptides      Peptide[]
  prescriptions Prescription[]
  vials         Vial[]
  syringes      Syringe[]
  protocols     Protocol[]
  plannedDoses  PlannedDose[]
  doseLogs      DoseLog[]
  journal       JournalEntry[]
  labPanels     LabPanel[]
  documents     Document[]
  auditLogs     AuditLog[]
  wearableDaily WearableDaily[]
  stacks        Stack[]
  pushSubscriptions PushSubscription[]
  reminderSends     ReminderSend[]
  purchases         Purchase[]
  bodyCompScans     BodyCompScan[]
  metabolicTests    MetabolicTest[]
  bodyCompPrecision BodyCompPrecision[]
  lifeEvents        LifeEvent[]
  ecgRecordings     EcgRecording[]
}

// Web Push subscription for an installed PWA — one row per device/browser.
// endpoint is the push service URL (unique per subscription); p256dh/auth are
// the client's encryption keys. Expired subscriptions (push service returns
// 404/410) are deleted by the sender.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}

// Exactly-once ledger for reminder notifications. One row per delivered event;
// the unique key IS the claim (insert wins, duplicate insert loses). `key` is
// "<protocolId>@<HH:MM>" | "<protocolId>@untimed" for slot reminders, or "nag"
// for the daily still-pending summary. protocolId inside the key is a soft ref
// (rows outlive protocol deletion harmlessly — they only block re-sends).
model ReminderSend {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  dayKey  String // local "YYYY-MM-DD"
  key     String
  channel String // webpush | ha
  sentAt  DateTime @default(now())

  @@unique([userId, dayKey, key])
}

model Peptide {
  id                  String  @id @default(cuid())
  userId              String?
  user                User?   @relation(fields: [userId], references: [id])
  name                String
  aliases             String? // JSON array
  category            String?
  substanceClass      String  @default("mass") // mass | IU  (never auto-convert between)
  defaultStrengthMg   Decimal?
  halfLifeHours       Decimal?
  minIntervalHours    Decimal?
  /// Beyond-use days after reconstitution. Null → global default (28), see lib/bud.ts.
  defaultBudDays      Int?
  missedDosePolicy    String  @default("prompt") // skip | take_now | prompt
  storageNotes        String?
  route               String  @default("injection") // injection | oral  (oral skips recon/syringe/site)

  prescriptions Prescription[]
  vials         Vial[]
  protocols     Protocol[]
  purchaseItems PurchaseItem[]

  blendComponents BlendComponent[] @relation("BlendParent")
  memberOfBlends  BlendComponent[] @relation("BlendMember")
}

/// One component of a vendor blend (e.g. GHK-Cu within KLOW).
/// `peptideId` is the BLEND; `componentPeptideId` is the compound it delivers,
/// so blend-delivered mass aggregates with standalone protocols for that compound.
model BlendComponent {
  id                 String  @id @default(cuid())
  peptideId          String
  peptide            Peptide @relation("BlendParent", fields: [peptideId], references: [id], onDelete: Cascade)
  componentPeptideId String
  componentPeptide   Peptide @relation("BlendMember", fields: [componentPeptideId], references: [id])
  /// Mass of this component in one labelled vial of the blend, in mg.
  massMg             Decimal
  /// label | coa | assumed — drives the mandatory "derived" badge.
  source             String  @default("label")
  sortIndex          Int     @default(0)

  @@unique([peptideId, componentPeptideId])
  @@index([componentPeptideId])
}

model Prescription {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  // A prescription is EITHER per-peptide (peptideId set) OR per-stack (stackId
  // set, peptideId null) — a grouped script covering all the stack's compounds.
  peptideId         String?
  peptide           Peptide?  @relation(fields: [peptideId], references: [id])
  stackId           String?
  stack             Stack?    @relation(fields: [stackId], references: [id])
  prescriber        String? // ENCRYPTED
  pharmacy          String? // ENCRYPTED
  source            String?
  cost              Decimal?
  currency          String?   @default("AUD")
  quantity          Int?
  refillsAuthorized Int?
  refillsRemaining  Int?
  dateWritten       DateTime?
  nextRefill        DateTime?
  expiration        DateTime?
  doseInstructions  String? // ENCRYPTED
  leadTimeDays      Int? // days from ordering to in-hand for this source
  sourceDocumentId  String?
  sourceDocument    Document? @relation(fields: [sourceDocumentId], references: [id])
  status            String    @default("active") // active | expired | cancelled

  vials     Vial[]
  protocols Protocol[]
}

model Vial {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  peptideId       String
  peptide         Peptide   @relation(fields: [peptideId], references: [id])
  prescriptionId  String?
  prescription    Prescription? @relation(fields: [prescriptionId], references: [id])
  labelStrengthMg Decimal   // total peptide mass in the vial — numerator of all math
  lot             String?
  expiry          DateTime?
  status          String    @default("sealed") // sealed | in_use | finished | discarded
  storageLocation String?
  openedAt        DateTime?
  finishedAt      DateTime?
  // Which invoice line bought this vial. One line can cover N vials (quantity),
  // so the landed unit cost — base price plus its share of the invoice's
  // shipping/fees — is the line's, divided by the line quantity. Null = no cost
  // data recorded for this vial; cost analytics reports it as uncosted rather
  // than assuming zero.
  purchaseItemId  String?
  purchaseItem    PurchaseItem? @relation(fields: [purchaseItemId], references: [id])

  preparations Preparation[]
}

// ── Cost tracking ───────────────────────────────────────────────────────────
// A Purchase is one invoice/order. Shipping, tax, fees and discounts are held
// at the invoice level (they are properties of the ORDER, not of any one item)
// and allocated across its lines at read time by `allocationMethod`. Nothing
// derived is stored: change the method and every landed cost recomputes.
model Purchase {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  vendor           String? // supplier/pharmacy name — plaintext, like Prescription.source (grouped on)
  reference        String? // ENCRYPTED — invoice/order number
  orderedAt        DateTime // Date-only (UTC midnight), per MIGRATIONS.md rule 3
  receivedAt       DateTime? // Date-only (UTC midnight)
  currency         String    @default("AUD")
  // Invoice-level overhead. Allocatable overhead = shipping + tax + fees − discount.
  shippingCost     Decimal   @default(0)
  taxCost          Decimal   @default(0)
  otherFees        Decimal   @default(0)
  discount         Decimal   @default(0)
  /// value = pro-rata on line subtotal | quantity = equal per unit | none = leave unallocated
  allocationMethod String    @default("value")
  notes            String? // ENCRYPTED
  createdAt        DateTime  @default(now())

  items PurchaseItem[]

  @@index([userId, orderedAt])
}

// One line on an invoice. `kind` splits the two things a peptide order contains:
//   peptide    — vials of a compound; links to the Vial rows it bought
//   consumable — needles, swabs, sharps containers, pen tips, bac water, …
// Consumables carry unitsPerPack (pieces in a box) and an optional unitsPerDose
// so a modelled per-injection consumable cost can be derived; leave unitsPerDose
// null and the line only contributes to the amortised figure.
model PurchaseItem {
  id           String   @id @default(cuid())
  purchaseId   String
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  kind         String // peptide | consumable
  peptideId    String?
  peptide      Peptide? @relation(fields: [peptideId], references: [id])
  /// consumable taxonomy: needle | syringe | swab | sharps_container | pen_tip | bac_water | other
  category     String?
  description  String
  quantity     Int      @default(1)
  unitCost     Decimal
  unitsPerPack Int?
  unitsPerDose Decimal?
  sortIndex    Int      @default(0)

  vials Vial[]

  @@index([purchaseId])
}

// "Reconstitution / Preparation" — supports both dry-reconstituted and premixed vials.
model Preparation {
  id                  String   @id @default(cuid())
  vialId              String
  vial                Vial     @relation(fields: [vialId], references: [id])
  prepType            String   // reconstituted | premixed
  bacWaterMl          Decimal? // null if premixed
  totalMg             Decimal  // strength snapshot at prep time
  concentrationMcgPerMl Decimal // computed (reconstituted) or entered (premixed)
  reconstitutedAt     DateTime @default(now())
  beyondUseDate       DateTime?
  remainingMl         Decimal
  active              Boolean  @default(true)
  notes               String? // ENCRYPTED

  doseLogs DoseLog[]
}

model Syringe {
  id             String  @id @default(cuid())
  userId         String?
  user           User?   @relation(fields: [userId], references: [id])
  name           String
  graduationType String  // units | ml
  // syringe | pen — pens dial a dose (dose-window graphic) rather than drawing
  // into a barrel; presentation + wording only, never dose math.
  deviceType     String  @default("syringe")
  unitsPerMl     Int     @default(100)
  capacityMl     Decimal
  capacityUnits  Int
  increment      Decimal

  doseLogs DoseLog[]
}

model Protocol {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id])
  peptideId            String
  peptide              Peptide   @relation(fields: [peptideId], references: [id])
  prescriptionId       String?
  prescription         Prescription? @relation(fields: [prescriptionId], references: [id])
  stackId              String?
  stack                Stack?    @relation(fields: [stackId], references: [id])
  vialId               String? // pinned stack vial (soft ref, no @relation); null = legacy/non-stack, resolve by peptideId
  name                 String
  source               String    @default("manual") // manual | prescription
  scheduleType         String    @default("fixed_times") // fixed_times | interval | titration
  scheduleRule         String? // RRULE-like / JSON
  rebaseMode           String    @default("fixed_anchor") // fixed_anchor | rolling
  adherenceWindowMin   Int       @default(120)
  defaultSyringeId     String?
  targetDose           Decimal?
  doseInputUnit        String    @default("mcg") // mcg | mg | ml | units
  doseBasis            String    @default("per_injection") // per_injection | per_week
  startDate            DateTime?
  endDate              DateTime?
  status               String    @default("active") // active | paused | completed

  // A COURSE-level on/off plan: how many weeks to run before deliberately
  // stopping, and how long to stay off before restarting. Distinct from the
  // schedule's `cycle` DayPattern (lib/schedule/entries), which is an intra-week
  // dosing RHYTHM in DAYS (e.g. 5-on/2-off). These are WEEKS and govern whether
  // the protocol should be running at all.
  //
  //   cycleOnWeeks   null = continuous / no planned stop.
  //   cycleOffWeeks  null = stop and do not auto-plan a restart.
  //   cycleAnchor    start of the CURRENT on-cycle; null falls back to
  //                  startDate. Bumped forward on each restart so `startDate`
  //                  keeps meaning "when this protocol first began".
  cycleOnWeeks  Int?
  cycleOffWeeks Int?
  cycleAnchor   DateTime?
  /// Groups every revision of one course. Null = standalone and resolves to the
  /// protocol's own id (lib/protocol-revision.courseKey), so existing rows need
  /// no backfill. Analytics groups on this rather than walking a self-link.
  courseId String?

  steps        ProtocolStep[]
  plannedDoses PlannedDose[]
  doseLogs     DoseLog[]

  @@index([userId, courseId])
}

// A peptide "stack": a named group over real, separately-tracked protocols (each
// its own peptide + vial + premixed preparation). Thin grouping — dosing/inventory
// logic is unchanged; the stack adds combined entry, display and one-tap logging.
model Stack {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  notes     String?
  createdAt DateTime @default(now())

  protocols     Protocol[]
  prescriptions Prescription[]
}

model ProtocolStep {
  id            String   @id @default(cuid())
  protocolId    String
  protocol      Protocol @relation(fields: [protocolId], references: [id])
  stepIndex     Int
  dose          Decimal
  doseInputUnit String
  durationDays  Int?
  notes         String?
}

model PlannedDose {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  protocolId      String
  protocol        Protocol @relation(fields: [protocolId], references: [id])
  scheduledAt     DateTime
  targetDose      Decimal?
  doseInputUnit   String?
  status          String   @default("planned") // planned | taken | missed | skipped
  generatedFromStep Int?
  reminderSentAt  DateTime?

  doseLog DoseLog?

  @@unique([protocolId, scheduledAt])
}

model DoseLog {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  clientUuid      String      @unique // offline-sync dedup
  preparationId   String?     // null for oral / non-injection doses
  preparation     Preparation? @relation(fields: [preparationId], references: [id])
  protocolId      String?
  protocol        Protocol?   @relation(fields: [protocolId], references: [id])
  plannedDoseId   String?     @unique
  plannedDose     PlannedDose? @relation(fields: [plannedDoseId], references: [id])
  takenAt         DateTime
  scheduledAt     DateTime?
  deltaMinutes    Int?
  doseMcg         Decimal     // canonical mass
  doseInputUnit   String
  volumeMl        Decimal
  syringeUnits    Decimal?
  syringeId       String?
  syringe         Syringe?    @relation(fields: [syringeId], references: [id])
  injectionSite   String?
  route           String?     // injection | oral  (snapshot; null = legacy injection)
  source          String      @default("app") // app | ha_action | import
  notes           String? // ENCRYPTED
  // Device-local tracking day ("YYYY-MM-DD") + IANA zone stamped by the CLIENT
  // at log time — the travel-proof day bucket. The tracking day rolls at 02:00
  // phone-local. takenAt stays the authoritative UTC instant; localDay freezes
  // which day the dose belongs to regardless of the server TZ or where it is
  // later viewed from.
  // Null = legacy row or legacy client → readers fall back to server-TZ
  // bucketing of takenAt (the pre-1.3.0 behaviour, identical when zones match).
  localDay        String?
  tz              String?
  createdAt       DateTime    @default(now())
}

model JournalEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  date        DateTime
  weight      Decimal?
  weightUnit  String?
  mood        Int?
  energy      Int?
  sleep       Decimal?
  calories    Int?     // daily energy intake (kcal)
  proteinG    Decimal? // daily protein (grams)
  waterMl     Int?     // daily water intake (mL)
  sideEffects String? // ENCRYPTED (JSON: array of {symptom, severity} or legacy string[])
  doseLogId   String?
  notes       String? // ENCRYPTED
}

model Document {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  kind               String   // prescription | lab_report | dexa_report | rmr_report | ecg_report | other
  filePath           String
  mime               String?
  uploadedAt         DateTime @default(now())
  extractionStatus   String   @default("pending") // pending | extracted | confirmed | failed | manual (manual = keyed by hand, no parser run)
  extractionConfidence Decimal?

  prescriptions  Prescription[]
  labPanels      LabPanel[]
  bodyCompScans  BodyCompScan[]
  metabolicTests MetabolicTest[]
  ecgRecordings  EcgRecording[]
}

model Biomarker {
  id          String  @id @default(cuid())
  name        String  @unique
  defaultUnit String?
  category    String?
  optimalLow  Decimal?
  optimalHigh Decimal?

  results LabResult[]
}

model LabPanel {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  collectedDate DateTime
  labSource     String?
  documentId    String?
  document      Document? @relation(fields: [documentId], references: [id])
  notes         String? // ENCRYPTED

  results LabResult[]
}

model LabResult {
  id           String    @id @default(cuid())
  labPanelId   String
  labPanel     LabPanel  @relation(fields: [labPanelId], references: [id])
  biomarkerId  String
  biomarker    Biomarker @relation(fields: [biomarkerId], references: [id])
  value        String // ENCRYPTED (string to allow "<3", ">90", numeric)
  unit         String?
  referenceLow Decimal?
  referenceHigh Decimal?
  flag         String?   // low | normal | high | borderline
}

// Curated peptide enrichment override (reference-only, attributed to
// peptidedosages.com). ADDITIVE table — the weekly refresh upserts one row per
// peptide; the read helper (getEnrichment) prefers these rows over the committed
// seed JSON. On a per-peptide scrape failure the refresh keeps the last-good row
// (never wipes). `dataJson` is the full EnrichmentEntry serialised as JSON.
model PeptideReference {
  id          String   @id @default(cuid())
  peptideName String   @unique
  dataJson    String // serialised EnrichmentEntry
  source      String // source page URL
  fetchedAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  entityType String
  entityId   String
  changedAt  DateTime @default(now())
  field      String
  oldValue   String?
  newValue   String?
}

// Daily wellness snapshot imported from a wearable (Garmin). One row per
// (user, day, source); re-syncs upsert idempotently. Numeric metrics are
// plaintext so they're chartable/aggregatable; only `raw` (the full payload)
// is ENCRYPTED at the app layer.
model WearableDaily {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id])
  date   DateTime // local-midnight of the wellness day
  source String   // "garmin"

  // sleep
  sleepSeconds      Int?
  sleepDeepSeconds  Int?
  sleepLightSeconds Int?
  sleepRemSeconds   Int?
  sleepAwakeSeconds Int?
  sleepScore        Int?

  // recovery
  restingHr       Int?
  hrvMs           Decimal?
  hrvStatus       String? // balanced | unbalanced | low | poor
  bodyBatteryHigh Int?
  bodyBatteryLow  Int?
  stressAvg       Int?

  // body composition
  weightKg   Decimal?
  bmi        Decimal?
  bodyFatPct Decimal?

  // activity
  steps            Int?
  caloriesActive   Int?
  vo2max           Decimal?
  intensityMinutes Int?

  // misc
  spo2Avg        Int?
  respirationAvg Decimal?

  // Training metrics (Fenix 9 Pro era, added 2026-09-03 via ALTER TABLE ADD COLUMN — never a table rebuild).
  // Plaintext like every other daily number here; the full Garmin responses stay under encrypted `raw`.
  trainingReadiness      Int? // 0–100
  trainingReadinessLevel String? // as Garmin prints: NONE | LOW | MODERATE | HIGH | PRIME
  acuteLoad              Int? // 7-day acute training load
  chronicLoad            Int? // 28-day chronic training load
  acwr                   Decimal? // acute : chronic workload ratio
  acwrStatus             String? // as Garmin prints (e.g. LOW | OPTIMAL | HIGH)
  trainingStatus         String? // leading word of Garmin's feedback phrase (e.g. PRODUCTIVE)
  enduranceScore         Int?
  hillScore              Int?
  fitnessAge             Decimal?
  ltHr                   Int? // lactate-threshold heart rate, bpm
  ltSpeedMs              Decimal? // lactate-threshold running speed, m/s (pace derived at read time)
  floorsClimbed          Int?
  restingHr7d            Int? // Garmin's 7-day resting-HR average ending this day

  // logged activities (deliberate workouts; distinct from passive steps/intensity) — plaintext (read on month/wellness paths)
  activityCount  Int?
  activitiesJson String?

  raw            String? // ENCRYPTED — full normalised JSON payload (future-proofing)

  syncedAt DateTime @default(now())

  @@unique([userId, date, source])
}

// ── Body composition (DEXA + RMR) ──

/// Whole-body DXA header: one row per scan. Totals INCLUDE the head (Hologic's basis for FMI/LMI/ALMI).
/// Every report-derived number is an ENCRYPTED string; decrypt in server code, never SQL.
/// Subtotal (head-excluded) is derived (total − head), never stored.
model BodyCompScan {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  scannedAt           DateTime // scan instant (epoch ms at rest)
  localDay            String // "YYYY-MM-DD" — joins WearableDaily.date (local midnight) and DoseLog.localDay
  tz                  String // e.g. "Australia/Brisbane"
  modality            String   @default("dxa") // dxa only; BIA never lands here (stays in WearableDaily)
  deviceMake          String? // "Hologic"
  deviceModel         String? // "Horizon A"
  deviceSerial        String? // comparability + LSC key; private column, excluded from exports
  softwareVersion     String? // parser layout key; a change breaks comparability
  scanMode            String? // "Auto Whole Body Fan Beam"
  facility            String? // short label, no address
  referencePopulation String? // e.g. "NHANES/BMDCS 2012 White Male" — percentiles are meaningless without it
  sex                 String // male | female (reference-population basis; User has no sex column)
  ageYears            Decimal // age at scan as printed
  heightCm            Decimal
  clinicWeightKg      String? // ENCRYPTED  clinic scale; DXA total mass is a separate number

  // Whole-body totals (grams, as printed)
  totalFatG  String // ENCRYPTED
  totalLeanG String // ENCRYPTED  lean soft tissue, EXCLUDING BMC
  totalBmcG  String // ENCRYPTED
  totalMassG String // ENCRYPTED
  pctFat     String // ENCRYPTED  as printed; lib recomputes and checksums
  pctFatYn   String? // ENCRYPTED  young-normal percentile
  pctFatAm   String? // ENCRYPTED  age-matched percentile

  // Hologic visceral-adipose estimate (device-derived, not recomputable). Store all three; they are one measurement.
  vatMassG     String? // ENCRYPTED
  vatVolumeCm3 String? // ENCRYPTED
  vatAreaCm2   String? // ENCRYPTED

  // Whole-body bone summary (not a diagnostic site; site-specific scans are a clinician call)
  totalBmdGcm2 String? // ENCRYPTED
  bmdTScore    String? // ENCRYPTED  stored, hidden in UI under age 50
  bmdZScore    String? // ENCRYPTED
  bmdCvPct     Decimal? // "Total BMD CV" as printed; probably vendor, not site precision

  // Report-printed percentiles for indices the lib recomputes (NHANES tables are not reproducible in-app)
  fmiYn  String? // ENCRYPTED
  fmiAm  String? // ENCRYPTED
  lmiYn  String? // ENCRYPTED
  lmiAm  String? // ENCRYPTED
  almiYn String? // ENCRYPTED
  almiAm String? // ENCRYPTED

  // Pre-scan standardisation — tri-state (null = not recorded). NEVER default to true.
  prepFasted             Boolean?
  prepFastingHours       Decimal?
  prepNoCaffeine         Boolean?
  prepNoTrainingPriorDay Boolean? // no moderate/vigorous session in the prior 24 h
  prepActiveTravel       Boolean? // cycled/ran to the clinic (true = confound, recorded not judged)
  prepEuhydratedVoided   Boolean? // normal fluids, nothing in the last 30 min, bladder voided
  prepIllnessFree14d     Boolean?
  prepSameDeviceAsPrior  Boolean? // derived from deviceSerial+softwareVersion when both known; manual otherwise
  creatineStatus         String? // stable | started | stopped | none — creatine/glycogen move DXA lean ~1 kg
  carbPattern48h         String? // normal | loaded | depleted

  // Versioned JSON tail for the clutter that is kept-but-not-columned: regional BMD for ribs/spine/pelvis,
  // total area, analysis timestamp, operator-free header fields. Never queried; never exported.
  reportJson String?

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])
  notes      String? // ENCRYPTED
  createdAt  DateTime  @default(now())

  regions        BodyCompRegion[]
  metabolicTests MetabolicTest[]

  @@index([userId, scannedAt])
}

/// Regional rows exactly as APEX prints them. Subtotal/total are derived. Numeric fields are ENCRYPTED strings.
model BodyCompRegion {
  id       String       @id @default(cuid())
  scanId   String
  scan     BodyCompScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  region   String // l_arm | r_arm | trunk | l_leg | r_leg | head | android | gynoid
  bmcG     String? // ENCRYPTED  null for android/gynoid (not printed)
  fatG     String // ENCRYPTED
  leanG    String // ENCRYPTED  lean soft tissue; lean+BMC derived
  totalG   String // ENCRYPTED
  pctFat   String // ENCRYPTED
  pctFatYn String? // ENCRYPTED
  pctFatAm String? // ENCRYPTED
  bmdGcm2  String? // ENCRYPTED  arms / legs / head only

  @@unique([scanId, region])
}

/// Resting metabolic rate by indirect calorimetry. Manual entry (results page is an image).
model MetabolicTest {
  id                         String   @id @default(cuid())
  userId                     String
  user                       User     @relation(fields: [userId], references: [id])
  testedAt                   DateTime
  localDay                   String
  tz                         String
  method                     String // ic_vo2_only | ic_vo2_vco2 | other
  deviceLabel                String? // e.g. "VO2-only analyser (model unconfirmed)"
  facility                   String?
  measuredRmrKcal            String // ENCRYPTED
  kcalPerLitreO2             String? // ENCRYPTED  e.g. 4.81 (implied RQ ≈ 0.79)
  vo2MlMin                   String? // ENCRYPTED  if the clinic prints it
  vco2MlMin                  String? // ENCRYPTED
  rq                         String? // ENCRYPTED
  durationMin                Int?
  steadyStateCvPct           String? // ENCRYPTED  Compher criterion: 5 min at CV < 10 %
  sex                        String
  ageYears                   Decimal
  heightCm                   Decimal
  weightKg                   String // ENCRYPTED  the weight the clinic fed its equation
  reportedPredictedKcal      String? // ENCRYPTED  as printed; lib recomputes every equation
  reportedPredictionEquation String? // label only ("Mifflin-St Jeor")
  reportedActivityFactor     String? // ENCRYPTED  stored verbatim, NEVER used to compute a target
  reportedActivityLabel      String? // e.g. "Heavy"

  // Pre-test standardisation — tri-state. Shared list with the scan; when both exist on one visit the form asks once.
  prepFasted             Boolean?
  prepFastingHours       Decimal?
  prepNoCaffeine         Boolean?
  prepNoTrainingPriorDay Boolean?
  prepActiveTravel       Boolean?
  prepRestMinBeforeTest  Int?
  prepRested             Boolean?
  prepIllnessFree14d     Boolean?
  prepAwakeQuiet         Boolean? // still, no talking, no reading during the test
  roomTempC              Decimal?

  bodyCompScanId String?
  bodyCompScan   BodyCompScan? @relation(fields: [bodyCompScanId], references: [id]) // same-visit scan → FFM denominator
  documentId     String?
  document       Document?     @relation(fields: [documentId], references: [id])
  notes          String? // ENCRYPTED
  createdAt      DateTime      @default(now())

  @@index([userId, testedAt])
}

/// Precision (LSC) configuration per device serial. Seeded with literature defaults; overwritten by the clinic's own
/// in-vivo precision or by a same-day repositioned duplicate scan. Lives in its own table so User is never rebuilt.
model BodyCompPrecision {
  id                      String   @id @default(cuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id])
  deviceSerial            String? // null = default for any device
  source                  String // device_class_default | clinic_supplied | measured_own | iscd_min
  fatCvPct                Decimal? // technical same-day CV; LSC = 2.77 × CV
  leanCvPct               Decimal?
  pctFatLscAbs            Decimal? // %-points
  almCvPct                Decimal?
  vatCvPct                Decimal?
  bmdCvPct                Decimal?
  rmrCvPct                Decimal? // device+biological combined
  practicalFatMultiplier  Decimal? // consecutive-day / same-day ratio (Zemski 2019: 1.9 fat, 3.4 lean)
  practicalLeanMultiplier Decimal?
  note                    String?
  createdAt               DateTime @default(now())

  @@unique([userId, deviceSerial, source])
}

/// Illness / travel / other windows that contaminate wearable and scan comparisons. Shaded on every
/// chart; days inside a window are excluded from interval statistics and counted.
model LifeEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  kind      String // illness | travel | other
  startDay  String // YYYY-MM-DD (local)
  endDay    String // YYYY-MM-DD (local), inclusive; >= startDay
  label     String? // short, plaintext, e.g. "flu" — NEVER a diagnosis narrative; details go in notes
  notes     String? // ENCRYPTED
  createdAt DateTime @default(now())

  @@index([userId, startDay])
}

/// One Garmin ECG recording, imported whole from the PDF the Connect phone app
/// exports (Garmin has no ECG API — the PDF is the only route out).
///
/// Everything here is READ OFF THE REPORT. The app prints Garmin's own words
/// and never adds a reading of its own: `result`, `interpretation` and
/// `leadNote` are stored verbatim and rendered verbatim.
///
/// PII on the page — patient name, date of birth, age and sex — is deliberately
/// NOT parsed and has no column here (same rule the DEXA importer follows).
///
/// Identity is `(userId, recordedLocalKey)` — the time the report PRINTS, not the
/// instant that time resolves to. Re-importing the same recording (a second
/// download of the same ECG is a different file with a different `sourceHash`)
/// refreshes the row instead of duplicating it, and it stays one recording even
/// if the second import happens from a device in a different timezone.
model EcgRecording {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  recordedAt       DateTime // the IN-DOCUMENT recording instant, never the file's download time
  /// The recording time EXACTLY AS PRINTED, "YYYY-MM-DDTHH:mm". This, not the
  /// instant, is the recording's identity: the page carries no timezone, so the
  /// instant depends on which device did the importing, and importing the same
  /// report from a phone in another zone would otherwise store it twice.
  recordedLocalKey String
  localDay         String // "YYYY-MM-DD" — joins WearableDaily.date and DoseLog.localDay
  tz               String // IANA zone the local day was resolved in

  // Garmin's own findings, verbatim.
  result          String // ENCRYPTED  e.g. "Sinus Rhythm"
  avgHeartRateBpm String? // ENCRYPTED  integer as printed
  symptoms        String? // ENCRYPTED  null when the report prints "--" (none reported)
  interpretation  String? // ENCRYPTED  e.g. "This ECG recording does not show signs of AFib."
  leadNote        String? // e.g. "This waveform is similar to a Lead I ECG." — device fact, not a finding

  // Recording parameters as printed in the footer.
  durationSec   Int? // 30 for the standard recording
  paperSpeedMmS Decimal? // 25
  gainMmMv      Decimal? // 10
  sampleRateHz  Int? // 512 (the watch's rate; the PDF's own trace is decimated)

  // Provenance. `pdfTemplateVersion` is the parser's layout key — a change there
  // can silently break extraction, so it is stored on every row.
  deviceModel        String? // "fenix 9 Pro - inReach, 43 mm"
  deviceSoftware     String? // "6.38"
  ecgAppVersion      String?
  connectWebVersion  String?
  pdfTemplateVersion String?
  backendVersion     String?

  // The printed trace, re-drawn in the app's own palette. Vector path endpoints
  // lifted from the PDF and expressed as microvolts against the recording's own
  // isoelectric median; `waveformPoints` lets a list query say "this one has a
  // trace" without decrypting the samples.
  waveformJson   String? // ENCRYPTED  { baselineMv, strips: [{ t0Ms, dtMs, uv: number[] }] }
  waveformPoints Int?

  sourceHash String // sha256 of the PDF bytes — an exact re-upload is recognised before parsing

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])
  notes      String? // ENCRYPTED
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, recordedLocalKey])
  @@index([userId, recordedAt])
}
